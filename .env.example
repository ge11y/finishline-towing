# FINISHLINE Towing — environment
# Copy to .env.local for local work. Real values live in Vercel, never in the repo.

# Owner admin login
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=          # openssl rand -hex 32

# Supabase — tow_requests + sponsor_applications
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner notification email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_EMAIL_TO=                # override target; REMOVE at handover so Josh gets his own leads

# Set to 1 to keep a deploy out of search. Absent = indexable.
NOINDEX=
